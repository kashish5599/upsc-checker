GOOGLE_API_KEY=your_google_api_key

LANGFUSE_SECRET_KEY="your_langfuse_secret_key"
LANGFUSE_PUBLIC_KEY="your_langfuse_public_key"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# Gemini Developer API configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# Pinecone configuration (use the host for the selected index)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=upsc-checker
PINECONE_HOST=https://your-index-host.pinecone.io

# Optional path for the local persistent knowledge-document catalog
KNOWLEDGE_DB_PATH=.data/knowledge.sqlite3
TAVILY_API_KEY="your_tavily_api_key"
GEMINI_EVALUATION_MODEL=gemini-3.5-flash-lite
